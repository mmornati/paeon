# Paeon. Every secret also accepts NAME_FILE=/path (Docker secrets).
# The first part is for the core (`paeon serve`), the last for the executor (`paeon executor`).

# Required. Bearer token the webhook senders must present; 24 characters or more.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAEON_INGEST_TOKEN=

# Where the event log lives, and where the API listens.
PAEON_DB=paeon.sqlite
PAEON_HOST=127.0.0.1
PAEON_PORT=8080

# OpenObserve pull adapter (optional). Use an account that can only read the `triggers` stream.
# The URL is the internal one (http://openobserve:5080 on the same Docker network).
PAEON_OPENOBSERVE_URL=
PAEON_OPENOBSERVE_ORG=default
PAEON_OPENOBSERVE_USER=
PAEON_OPENOBSERVE_PASSWORD=
PAEON_OPENOBSERVE_POLL_SECONDS=60
# No evaluation row for this long opens the internal `source_stale` alert.
PAEON_OPENOBSERVE_STALE_SECONDS=900

# Heartbeat (optional): the push URL of an uptime-kuma "Push" monitor, called while Paeon is healthy.
PAEON_HEARTBEAT_URL=
PAEON_HEARTBEAT_SECONDS=60

# Rules file (optional): correlation, maintenance windows, models, triage, digest.
# See examples/paeon.yaml. The variables it names (api_key_env, token_env) are read from here.
PAEON_CONFIG=
# PAEON_TRIAGE_API_KEY=
# ANTHROPIC_API_KEY=
# PAEON_NTFY_TOKEN=
# One variable per secret of a channel under `notifiers` (docs/notifications.md), for example:
# PAEON_TELEGRAM_TOKEN=
# PAEON_DISCORD_WEBHOOK=
# PAEON_SMTP_PASSWORD=
# PAEON_UPTIME_KUMA_API_KEY=
# The whole Authorization header for `telemetry.otlp_endpoint`, e.g. "Basic <base64>".
# PAEON_OTLP_AUTHORIZATION=

# --- Acting (optional, `actions.enabled` in the rules file) ---------------------------------
# Shared by the core and the executor: how the core proves itself. 24 characters or more.
# PAEON_EXECUTOR_TOKEN=

# With `ui.proxy_secret`: the value your reverse proxy adds to each console request
# (header X-Paeon-Proxy), 24 characters or more.
# PAEON_UI_PROXY_SECRET=

# With `ui.auth: local`: the password the console asks for, 12 characters or more.
# PAEON_UI_ADMIN_PASSWORD=
# With `ui.auth: local` or `ui.settings`: encrypts what the console stores and signs its
# sessions. Any long random value, 32 characters or more: `openssl rand -base64 48`.
# PAEON_SECRET_KEY=

# The executor only (`paeon executor`). Never give these to the core.
# The key that signs Go / No-go links; 32 characters or more, different from the token above.
# PAEON_SIGNING_KEY=
# PAEON_EXECUTOR_DB=executor.sqlite
# PAEON_EXECUTOR_HOST=127.0.0.1
# PAEON_EXECUTOR_PORT=8081
# Named by `actions.coolify.token_env` and `actions.repository.github.token_env`.
# PAEON_COOLIFY_TOKEN=
# PAEON_GITHUB_TOKEN=
# Set to 1 to hold everything at "observe" whatever the policies say.
# PAEON_KILL_SWITCH=
